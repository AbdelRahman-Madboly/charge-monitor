<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Platform window theme only; Compose draws everything else. The window colour matches the
      Compose background so there is no white or black flash before the first frame. The night
      variant lives in values-night.
    -->
    <style name="Theme.ChargeMonitor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
